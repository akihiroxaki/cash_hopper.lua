
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local player = Players.LocalPlayer

local url = "https://raw.githubusercontent.com/LeoKholYt/roblox/main/lk_serverhop.lua"
local module

-- Retry loading the hopper if downloading fails.
while not module do
    local ok, result = pcall(function()
        local source = game:HttpGet(url)
        local fn, loadErr = loadstring(source)

        assert(fn, loadErr)

        local loadedModule = fn()

        assert(
            loadedModule
                and type(loadedModule.Teleport) == "function",
            "Invalid server-hop module"
        )

        return loadedModule
    end)

    if ok then
        module = result
    else
        warn("[Cash Hopper] Load failed: " .. tostring(result))
        warn("[Cash Hopper] Retrying in 5 seconds...")
        task.wait(5)
    end
end

local retryPending = false

local function retryHop(reason)
    if retryPending then return end
    retryPending = true

    warn("[Cash Hopper] Teleport failed: " .. tostring(reason))
    warn("[Cash Hopper] Retrying in 5 seconds...")

    task.delay(5, function()
        retryPending = false

        local ok, err = pcall(function()
            module:Teleport(game.PlaceId)
        end)

        if not ok then
            retryHop(err)
        end
    end)
end

-- Listen for Roblox teleport failures.
TeleportService.TeleportInitFailed:Connect(
    function(failedPlayer, result, errorMessage)
        if failedPlayer == player then
            retryHop(tostring(result) .. ": " .. tostring(errorMessage))
        end
    end
)

-- Start the first hop.
local ok, err = pcall(function()
    module:Teleport(game.PlaceId)
end)

if not ok then
    retryHop(err)
end
