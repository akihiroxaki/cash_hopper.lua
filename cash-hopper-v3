
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function isVisible(item, gui)
    local p = item

    while p and p ~= gui do
        if p:IsA("GuiObject") and not p.Visible then
            return false
        end

        if p:IsA("ScreenGui") and not p.Enabled then
            return false
        end

        p = p.Parent
    end

    return p == gui
end

local function hasCashEventNotification(gui)
    for _, item in ipairs(gui:GetDescendants()) do
        if (item:IsA("TextLabel")
            or item:IsA("TextButton"))
            and isVisible(item, gui) then

            if item.Text:lower():find(
                "cash event has started", 1, true
            ) then
                return true
            end
        end
    end

    return false
end

local function hasVisibleImage(root, gui)
    if (root:IsA("ImageLabel") or root:IsA("ImageButton"))
        and isVisible(root, gui) then
        return true
    end

    for _, item in ipairs(root:GetDescendants()) do
        if (item:IsA("ImageLabel")
            or item:IsA("ImageButton"))
            and isVisible(item, gui) then
            return true
        end
    end

    return false
end

local function hasCashEventIconAndTimer(gui)
    for _, item in ipairs(gui:GetDescendants()) do
        if (item:IsA("TextLabel")
            or item:IsA("TextButton"))
            and isVisible(item, gui) then

            local text = item.Text:lower()

            local timer =
                text:match("%d+%s*m%s*%d+%s*s")
                or text:match("%d+%s*s")
                or text:match("%d+:%d%d")

            if timer then
                local parent = item.Parent

                -- Look for an image near the countdown.
                for _ = 1, 3 do
                    if not parent or parent == gui then
                        break
                    end

                    if hasVisibleImage(parent, gui) then
                        return true
                    end

                    parent = parent.Parent
                end
            end
        end
    end

    return false
end

local function detectCashEvent()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then
        return false
    end

    return hasCashEventNotification(gui)
        or hasCashEventIconAndTimer(gui)
end

print("[Cash Hopper] Checking for Cash Event...")

local found = false
local deadline = os.clock() + 15

while os.clock() < deadline do
    if detectCashEvent() then
        found = true
        break
    end

    task.wait(0.25)
end

if found then
    warn("[Cash Hopper] Cash Event detected!")
    warn("[Cash Hopper] Waiting 4 minutes 30 seconds...")

    task.wait(270)

    warn("[Cash Hopper] Cooldown finished.")
else
    warn("[Cash Hopper] No event detected in 15 seconds.")
end

local ok, err = pcall(function()
    local url =
        "https://raw.githubusercontent.com/LeoKholYt/roblox/main/lk_serverhop.lua"

    local source = game:HttpGet(url)
    local fn, loadErr = loadstring(source)

    assert(fn, loadErr)

    local module = fn()

    assert(
        module and type(module.Teleport) == "function",
        "Server-hop module failed to load"
    )

    module:Teleport(game.PlaceId)
end)

if not ok then
    warn("[Cash Hopper] Error: " .. tostring(err))
end
