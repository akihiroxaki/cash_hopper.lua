
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function isVisible(item, gui)
    local p = item

    while p and p ~= gui do
        if p:IsA("GuiObject") and not p.Visible then
            return false
        end

        if p:IsA("ScreenGui") and not p.Enabled then
            return false
        end

        p = p.Parent
    end

    return p == gui
end

local function findText(gui, phrase)
    for _, item in ipairs(gui:GetDescendants()) do
        if (item:IsA("TextLabel")
            or item:IsA("TextButton"))
            and isVisible(item, gui) then

            if item.Text:lower():find(phrase, 1, true) then
                return true
            end
        end
    end

    return false
end

local function isTimer(text)
    text = text:lower()

    return text:match("%d+%s*m%s*%d+%s*s") ~= nil
        or text:match("%d+%s*s") ~= nil
end

local function findEventIndicator(gui)
    for _, item in ipairs(gui:GetDescendants()) do
        if (item:IsA("TextLabel")
            or item:IsA("TextButton"))
            and isVisible(item, gui)
            and isTimer(item.Text) then

            local parent = item.Parent

            for _ = 1, 3 do
                if not parent or parent == gui then
                    break
                end

                if parent:IsA("GuiObject") then
                    local hasIcon =
                        parent:IsA("ImageLabel")
                        or parent:IsA("ImageButton")

                    if not hasIcon then
                        for _, child in ipairs(
                            parent:GetDescendants()
                        ) do
                            if (child:IsA("ImageLabel")
                                or child:IsA("ImageButton"))
                                and isVisible(child, gui) then
                                hasIcon = true
                                break
                            end
                        end
                    end

                    if hasIcon then
                        return parent
                    end
                end

                parent = parent.Parent
            end
        end
    end

    return nil
end

local function indicatorStillVisible(root)
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return false end

    local timerFound = false
    local iconFound = false

    local function inspect(item)
        if not isVisible(item, gui) then
            return
        end

        if (item:IsA("TextLabel")
            or item:IsA("TextButton"))
            and isTimer(item.Text) then
            timerFound = true
        end

        if item:IsA("ImageLabel")
            or item:IsA("ImageButton") then
            iconFound = true
        end
    end

    inspect(root)

    for _, item in ipairs(root:GetDescendants()) do
        inspect(item)
    end

    return timerFound or iconFound
end

print("[Cash Hopper] Watching for Cash Event...")

local deadline = os.clock() + 15
local triggered = false
local eventRoot = nil

-- Watch continuously so the temporary notification isn't missed.
while os.clock() < deadline do
    local gui = player:FindFirstChildOfClass("PlayerGui")

    if gui then
        if findText(gui, "cash event has started") then
            triggered = true
            print("[Cash Hopper] Cash Event notification detected!")
            break
        end

        -- Also recognize an event already active when joining.
        if findText(gui, "cash event") then
            eventRoot = findEventIndicator(gui)

            if eventRoot then
                triggered = true
                print("[Cash Hopper] Active event indicator found!")
                break
            end
        end
    end

    task.wait(0.25)
end

if triggered then
    -- The notification may appear before the timer UI loads.
    local indicatorDeadline = os.clock() + 15

    while not eventRoot and os.clock() < indicatorDeadline do
        local gui = player:FindFirstChildOfClass("PlayerGui")

        if gui then
            eventRoot = findEventIndicator(gui)
        end

        if not eventRoot then
            task.wait(0.25)
        end
    end

    if not eventRoot then
        warn("[Cash Hopper] Event detected, but its indicator wasn't found.")
        warn("[Cash Hopper] Stopping to avoid hopping away.")
        return
    end

    warn("[Cash Hopper] Staying in this server.")
    warn("[Cash Hopper] Waiting for icon and countdown to disappear...")

    repeat
        task.wait(1)
    until not indicatorStillVisible(eventRoot)

    warn("[Cash Hopper] Event ended. Script stopped.")
    warn("[Cash Hopper] Execute again to search for another event.")
    return
end

-- No event detected during the search window: try one server hop.
local ok, err = pcall(function()
    local url =
        "https://raw.githubusercontent.com/LeoKholYt/roblox/main/lk_serverhop.lua"

    local source = game:HttpGet(url)
    local fn, loadErr = loadstring(source)

    assert(fn, loadErr)

    local module = fn()

    assert(
        module and type(module.Teleport) == "function",
        "Server-hop module failed to load"
    )

    module:Teleport(game.PlaceId)
end)

if not ok then
    warn("[Cash Hopper] Error: " .. tostring(err))
end
